@startuml
title Transfer Admin Right
autonumber
actor Player

box "Client"
participant Admin
participant OtherLobbyPlayers
end box

box "Server"
participant Lobby
endbox

activate Admin

Player -> Admin: requestTransferAdminRight

Admin -> Lobby: requestTransferAdminRights
activate Lobby
Lobby -> Lobby: setAdminRight
note right Lobby 
set isAdmin of current admin to false,
set the TargetPlayer's isAdmin to true
end note 
activate Lobby
Lobby -> OtherLobbyPlayers: NotifyAdminTransferRight
deactivate Lobby
Lobby --> Admin: responseTransferAdminRight
deactivate Lobby 
Admin --> Player: responseTransferAdminRight
deactivate Admin 





@enduml
